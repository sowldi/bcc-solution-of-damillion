# Пример конфигурации. Скопируйте в .env и заполните.
# Файл .env в Git не попадает (см. .gitignore). Ключи сюда НЕ вписывайте.

# Провайдер LLM: gemini | ollama | openai | anthropic
LLM_PROVIDER=gemini

# --- Google Gemini (ключ: https://aistudio.google.com/ → API keys) ---------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Ollama (локально, без ключа: https://ollama.com) ----------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# --- OpenAI ----------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Anthropic -------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- Общие параметры вызова модели -----------------------------------------
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=4
# Ограничение запросов в минуту (бесплатные тарифы строгие)
LLM_RPM=10
# Не больше запросов к модели за один прогон (стоимость ограничена и видна в отчёте)
LLM_MAX_REQUESTS=10
# Лимит длины ответа модели (токены)
LLM_MAX_OUTPUT_TOKENS=4096
# Свой адрес сервиса для gemini/openai/anthropic (прокси, совместимый API). Пусто — стандартный.
# Ключ передаётся только по https (или на локальный адрес).
LLM_BASE_URL=
